+            const int base = c * 128 + lane * 4;
+#pragma unroll
+            for (int j = 0; j < 4; ++j)
+                v[i][j] = f(__float2bfloat16(modulated(f(x[base + j]), inv, f(NW[base + j]), s[base + j], h[base + j])));
