+            for (int j = 0; j < 4; ++j) most = fmaxf(most, fabsf(v[i][j]));
+        }
+    }
+    most = tf_common::block_max_tree(most, scratch, 8);
+    const float row_scale = most > 0.f ? most / 127.f : 1.f;
