+    const f_wide = try tmaFunction(mod, "h3_gemm_int8_tma_wide");
+
+    var lt = try lt_.Library.open();
+    defer lt.close();
+    const handle = try lt_.createHandle(&lt);
+    var ws = try cuda.DeviceBuffer.alloc(gpu.d, workspace_bytes);
