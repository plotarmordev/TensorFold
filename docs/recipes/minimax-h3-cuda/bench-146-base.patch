+        .{ .name = "qkvc", .rows = 4120, .n = 21504, .k = 5376 },
+        .{ .name = "out ", .rows = 4120, .n = 5376, .k = 7168 },
+        .{ .name = "fc1 ", .rows = 4120, .n = 28672, .k = 5376 },
