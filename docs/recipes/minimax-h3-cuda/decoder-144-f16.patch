 // points exactly as the Metal kernels (zig/kernels/metal/h3/image_decoder.metal) hold them, fp32
 // sums; h3d_linear sums K sequentially in fp32, and h3d_finish applies bias and LayerScale at their points.
 #include <cuda_bf16.h>
+#include <cuda_fp16.h>
 #include <math.h>
 #include <mma.h>
 #include <stddef.h>
@@ -442,4 +443,13 @@ __global__ void __launch_bounds__(256) h3d_swiglu(const bf16* wide, bf16* act, H
     act[(size_t)y * 4096 + x] = __float2bfloat16(silu * f(r[4096 + x]));
 }
 
+// p.m values of bf16 to fp16, counting each that overflows fp16 (|x| > 65504) or falls below its normals in *lost.
+__global__ void __launch_bounds__(256) h3d_half(const bf16* x, __half* y, unsigned* lost, H3dShape p) {
+    const unsigned i = blockIdx.x * 256 + threadIdx.x;
+    if (i >= p.m) return;
+    const float v = f(x[i]);
+    y[i] = __float2half_rn(v);
+    if (fabsf(v) > 65504.0f || (v != 0.0f && fabsf(v) < 0x1p-14f)) atomicAdd(lost, 1u);
+}
+
 } // extern "C"
