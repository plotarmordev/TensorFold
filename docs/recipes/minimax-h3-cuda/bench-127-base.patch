diff --git a/zig/src/families/h3/prompt_cache.zig b/zig/src/families/h3/prompt_cache.zig
new file mode 100644
index 000000000..50c7b5de2
--- /dev/null
+++ b/zig/src/families/h3/prompt_cache.zig
@@ -0,0 +1,104 @@
+//! MiniMax-H3-Image's kept prompt states: a prompt's presentation and refined text rows held by the
+//! resident prompt server across pictures, least recently used inside a byte budget. The key is the
+//! prompt's exact bytes as tokenised; the geometry, marks and tokenizer are the process's own, checked
+//! at load, so the bytes alone decide. H3-Image has no negative prompt or CFG, so nothing else varies.
+const std = @import("std");
+
+/// Bytes of kept states without H3_PROMPT_CACHE: a few full-length prompts' worth.
+pub const default_bytes: usize = 256 << 20;
+
+/// One prompt's states: its rows' ids and tags and the refiner's text rows for them.
+const Entry = struct {
+    prompt: []u8,
+    ids: []u32,
+    tags: []i32,
+    text: []u16,
+    /// What the entry's slices hold, counted against the budget.
+    bytes: usize,
+
+    fn free(e: *Entry, a: std.mem.Allocator) void {
+        a.free(e.prompt);
+        a.free(e.ids);
+        a.free(e.tags);
+        a.free(e.text);
+        a.destroy(e);
+    }
+};
+
+/// The kept states of a `find` hit: the presentation's ids and tags and the refiner's text rows.
+pub const States = struct { ids: []const u32, tags: []const i32, text: []const u16 };
+
+pub const Cache = struct {
+    gpa: std.mem.Allocator,
+    /// Oldest first; a `find` or `keep` makes its entry the last.
+    entries: std.ArrayList(*Entry) = .empty,
+    /// `entries`' bytes held against `budget`.
+    held: usize = 0,
+    budget: usize,
+    hits: u64 = 0,
+    misses: u64 = 0,
+
+    /// MiB from H3_PROMPT_CACHE, or `default_bytes` unset; 0 keeps nothing, so the cache is off.
+    pub fn budgetOf(value: ?[]const u8) usize {
+        const v = value orelse return default_bytes;
+        const mib = std.fmt.parseInt(usize, v, 10) catch return default_bytes;
+        return mib << 20;
+    }
+
+    pub fn init(gpa: std.mem.Allocator, budget: usize) Cache {
+        return .{ .gpa = gpa, .budget = budget };
+    }
+
+    pub fn deinit(c: *Cache) void {
+        for (c.entries.items) |e| e.free(c.gpa);
+        c.entries.deinit(c.gpa);
+    }
+
+    /// The prompt's kept states, its entry now the newest; null on a miss.
+    pub fn find(c: *Cache, prompt: []const u8) ?States {
+        const i = c.indexOf(prompt) orelse {
+            c.misses += 1;
+            return null;
+        };
+        c.hits += 1;
+        const e = c.entries.items[i];
+        const last = c.entries.items.len - 1;
+        if (i < last) {
+            std.mem.copyForwards(*Entry, c.entries.items[i..last], c.entries.items[i + 1 .. last + 1]);
+            c.entries.items[last] = e;
+        }
+        return .{ .ids = e.ids, .tags = e.tags, .text = e.text };
+    }
+
+    /// The prompt's states kept, its entry newest, least-recently-used evicted until it fits.
+    /// An entry over the budget keeps nothing and evicts nothing; neither does an allocation
+    /// failure — a picture never fails for the cache.
+    pub fn keep(c: *Cache, prompt: []const u8, ids: []const u32, tags: []const i32, text: []const u16) void {
+        const bytes = prompt.len + 4 * (ids.len + tags.len) + 2 * text.len;
+        if (bytes > c.budget or c.indexOf(prompt) != null) return;
+        const e = c.gpa.create(Entry) catch return;
+        e.* = .{ .prompt = &.{}, .ids = &.{}, .tags = &.{}, .text = &.{}, .bytes = bytes };
+        e.prompt = c.gpa.dupe(u8, prompt) catch return e.free(c.gpa);
+        e.ids = c.gpa.dupe(u32, ids) catch return e.free(c.gpa);
+        e.tags = c.gpa.dupe(i32, tags) catch return e.free(c.gpa);
+        e.text = c.gpa.dupe(u16, text) catch return e.free(c.gpa);
+        // the copies are owned: only now may older entries leave for the room they need
+        c.held += bytes;
+        c.entries.append(c.gpa, e) catch return {
+            c.held -= bytes;
+            return e.free(c.gpa);
+        };
+        while (c.held > c.budget) c.dropOldest();
+    }
+
+    fn indexOf(c: *const Cache, prompt: []const u8) ?usize {
+        for (c.entries.items, 0..) |e, i| if (std.mem.eql(u8, e.prompt, prompt)) return i;
+        return null;
+    }
+
+    fn dropOldest(c: *Cache) void {
+        const e = c.entries.orderedRemove(0);
+        c.held -= e.bytes;
+        e.free(c.gpa);
+    }
+};
diff --git a/zig/src/families/h3/prompt_cache_test.zig b/zig/src/families/h3/prompt_cache_test.zig
new file mode 100644
index 000000000..5ebbe1fea
--- /dev/null
+++ b/zig/src/families/h3/prompt_cache_test.zig
@@ -0,0 +1,126 @@
+//! The prompt cache's contract: keyed by the prompt's exact bytes, states returned verbatim,
+//! least recently used evicted inside the budget, nothing kept or lost past it.
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+const testing = std.testing;
+
+/// ids, tags and text rows for `n` rows, their values the prompt's own.
+fn states(a: std.mem.Allocator, n: usize) !struct { []u32, []i32, []u16 } {
+    const ids = try a.alloc(u32, n);
+    const tags = try a.alloc(i32, n);
+    const text = try a.alloc(u16, n * 3);
+    for (ids, tags, 0..) |*id, *t, i| {
+        id.* = @intCast(1000 + i);
+        t.* = 1;
+    }
+    for (text, 0..) |*v, i| v.* = @intCast(i);
+    return .{ ids, tags, text };
+}
+
+test "h3 prompt cache: a kept prompt's states come back verbatim, another prompt misses" {
+    const a = testing.allocator;
+    var c = pc.Cache.init(a, 1 << 20);
+    defer c.deinit();
+    const s = try states(a, 4);
+    defer a.free(s[0]);
+    defer a.free(s[1]);
+    defer a.free(s[2]);
+
+    try testing.expectEqual(@as(?pc.States, null), c.find("a red fox"));
+    c.keep("a red fox", s[0], s[1], s[2]);
+    const hit = c.find("a red fox").?;
+    try testing.expectEqualSlices(u32, s[0], hit.ids);
+    try testing.expectEqualSlices(i32, s[1], hit.tags);
+    try testing.expectEqualSlices(u16, s[2], hit.text);
+    try testing.expect(c.find("a different prompt") == null);
+    try testing.expectEqual(@as(u64, 1), c.hits);
+    try testing.expectEqual(@as(u64, 2), c.misses);
+}
+
+test "h3 prompt cache: a found entry is newest, the least recently used evicted inside the budget" {
+    const a = testing.allocator;
+    const s = try states(a, 4);
+    defer a.free(s[0]);
+    defer a.free(s[1]);
+    defer a.free(s[2]);
+    // every key eight bytes, so each entry is the same size and two exactly fill the budget
+    const entry_bytes = "prompt-1".len + 4 * (4 + 4) + 2 * 12;
+
+    var c = pc.Cache.init(a, 2 * entry_bytes);
+    defer c.deinit();
+    c.keep("prompt-1", s[0], s[1], s[2]);
+    c.keep("prompt-2", s[0], s[1], s[2]);
+    try testing.expectEqual(@as(usize, 2 * entry_bytes), c.held);
+    // finding "prompt-1" makes it newest, so keeping the third evicts "prompt-2"
+    try testing.expect(c.find("prompt-1") != null);
+    c.keep("prompt-3", s[0], s[1], s[2]);
+    try testing.expect(c.find("prompt-2") == null);
+    try testing.expect(c.find("prompt-1") != null);
+    try testing.expect(c.find("prompt-3") != null);
+    try testing.expectEqual(@as(usize, 2 * entry_bytes), c.held);
+    try testing.expectEqual(@as(usize, 2), c.entries.items.len);
+}
+
+test "h3 prompt cache: kept states are the cache's own copies, not the caller's slices" {
+    const a = testing.allocator;
+    var c = pc.Cache.init(a, 1 << 20);
+    defer c.deinit();
+    const s = try states(a, 4);
+    defer a.free(s[0]);
+    defer a.free(s[1]);
+    defer a.free(s[2]);
+
+    c.keep("prompt", s[0], s[1], s[2]);
+    // the request arena's slices may be reused or overwritten; the kept states must not follow
+    s[0][0] = 9999;
+    s[1][0] = -7;
+    s[2][0] = 4242;
+    const hit = c.find("prompt").?;
+    try testing.expectEqual(@as(u32, 1000), hit.ids[0]);
+    try testing.expectEqual(@as(i32, 1), hit.tags[0]);
+    try testing.expectEqual(@as(u16, 0), hit.text[0]);
+}
+
+test "h3 prompt cache: an entry over the budget keeps nothing, a zero budget keeps nothing" {
+    const a = testing.allocator;
+    const s = try states(a, 4);
+    defer a.free(s[0]);
+    defer a.free(s[1]);
+    defer a.free(s[2]);
+    const entry_bytes = "prompt".len + 4 * (4 + 4) + 2 * 12;
+
+    var c = pc.Cache.init(a, entry_bytes - 1);
+    defer c.deinit();
+    c.keep("prompt", s[0], s[1], s[2]);
+    try testing.expectEqual(@as(usize, 0), c.held);
+    try testing.expect(c.find("prompt") == null);
+
+    var off = pc.Cache.init(a, 0);
+    defer off.deinit();
+    off.keep("prompt", s[0], s[1], s[2]);
+    try testing.expect(off.find("prompt") == null);
+}
+
+test "h3 prompt cache: keeping a prompt already kept changes nothing" {
+    const a = testing.allocator;
+    const s = try states(a, 4);
+    defer a.free(s[0]);
+    defer a.free(s[1]);
+    defer a.free(s[2]);
+
+    var c = pc.Cache.init(a, 1 << 20);
+    defer c.deinit();
+    c.keep("prompt", s[0], s[1], s[2]);
+    const held = c.held;
+    c.keep("prompt", s[0], s[1], s[2]);
+    try testing.expectEqual(held, c.held);
+    try testing.expectEqual(@as(usize, 1), c.entries.items.len);
+    try testing.expectEqual(@as(u64, 0), c.hits);
+}
+
+test "h3 prompt cache: H3_PROMPT_CACHE's MiB, default and off" {
+    try testing.expectEqual(pc.default_bytes, pc.Cache.budgetOf(null));
+    try testing.expectEqual(pc.default_bytes, pc.Cache.budgetOf("not a number"));
+    try testing.expectEqual(@as(usize, 0), pc.Cache.budgetOf("0"));
+    try testing.expectEqual(@as(usize, 64 << 20), pc.Cache.budgetOf("64"));
+}
