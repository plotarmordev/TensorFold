+        else {
+            __nv_bfloat162* pair = reinterpret_cast<__nv_bfloat162*>(y);
+            pair[0] = __floats2bfloat162_rn(p[0], p[1]);
+            pair[1] = __floats2bfloat162_rn(p[2], p[3]);
+        }
+    }
+}
